{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOwnByokSecretAndConfig",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": "arn:aws:ssm:us-east-2:345757498436:parameter/clawmart/box/*"
    },
    {
      "Sid": "WriteOwnAuditLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": "arn:aws:logs:us-east-2:345757498436:log-group:/clawmart/box/*"
    }
  ]
}
