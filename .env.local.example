# Auth runs inside the Convex deployment (convex/auth.ts), so the browser needs
# nothing beyond the deployment URL. The signing keypair (JWT_PRIVATE_KEY, JWKS)
# lives in Convex env only — set it with `npx @convex-dev/auth`, never here.
NEXT_PUBLIC_CONVEX_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
